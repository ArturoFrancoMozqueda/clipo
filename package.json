  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "e2e": "playwright test",
    "icons": "node scripts/icons.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "cap:sync": "npm run version:sync && npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run version:sync && npm run build && cap sync ios && cap open ios",
    "app:dev": "npm run build && electron .",
    "app:smoke": "npm run build && node scripts/app-smoke.mjs",
    "app:dist": "npm run build && node scripts/dist.mjs"
  },
