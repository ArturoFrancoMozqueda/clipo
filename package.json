{
  "name": "clipo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "node --test \"tests/*.test.ts\"",
    "icons": "node scripts/icons.mjs",
    "cap:sync": "npm run build && cap sync",
