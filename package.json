    "@capacitor/cli": "^8.4.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  },
  "overrides": {
    "onnxruntime-web": "$onnxruntime-web"
  },
  "engines": {
    "node": ">=22.18"
  },
  "description": "Editor de video fácil para móvil y PC",
  "author": "Clipo",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.clipo.editor",
    "productName": "Clipo",
    "directories": {
      "output": "release/build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "verifyUpdateCodeSignature": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Clipo usa el micrófono para grabar tu voz en el video."
      }
    },
    "dmg": {
      "artifactName": "Clipo-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clipo",
      "artifactName": "Clipo-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Clipo-Portable-${version}.${ext}"
    },
    "npmRebuild": false,
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
