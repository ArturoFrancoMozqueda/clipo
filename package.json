{
  "name": "clipo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "node --test \"tests/*.test.ts\"",
    "icons": "node scripts/icons.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "app:dev": "npm run build && electron .",
    "app:smoke": "npm run build && node scripts/app-smoke.mjs",
    "app:dist": "npm run build && node scripts/dist.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.3",
    "@capacitor/core": "^8.4.3",
    "@capacitor/ios": "^8.4.3",
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@huggingface/transformers": "4.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "lucide-react": "^0.468.0",
    "mediabunny": "1.61.3",
    "onnxruntime-web": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  },
  "description": "Editor de video fácil para móvil y PC",
  "author": "Clipo",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.clipo.editor",
    "productName": "Clipo",
    "directories": {
      "output": "release/build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clipo",
      "artifactName": "Clipo-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Clipo-Portable-${version}.${ext}"
    },
    "npmRebuild": false,
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ]
  }
}
